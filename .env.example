# nada-ai environment configuration
#
# Copy this file to `.env` and edit. Every variable below is read by
# pydantic-settings (see src/nada_ai/settings.py) unless noted otherwise.
# Uncommented values are the defaults already baked into the code — you only
# need to *set* a variable if you want something different from that default.
# Full walkthrough: docs/qdrant-pipeline-guide.md


# ==============================================================================
# SEARCH BACKEND SELECTION
# ==============================================================================

# Which vector/keyword search engine to use. Everything below is grouped by
# which backend it applies to.
#   opensearch (default) | qdrant
NADA_SEARCH_BACKEND=opensearch

# Logical name for the index (OpenSearch) or collection (Qdrant, unless
# NADA_QDRANT_COLLECTION_NAME overrides it below).
NADA_INDEX_NAME=nada-metadata


# ==============================================================================
# OPENSEARCH (used when NADA_SEARCH_BACKEND=opensearch)
# ==============================================================================

NADA_OPENSEARCH_URL=http://localhost:9200

# Auth mode: "basic" (user/password) or "aws_sigv4" (IAM — requires the
# `aws` optional extra: `uv sync --extra aws`).
NADA_OPENSEARCH_AUTH_MODE=basic
# NADA_OPENSEARCH_USER=
# NADA_OPENSEARCH_PASSWORD=

# TLS. Point at a custom CA bundle, or disable verification for self-signed
# dev clusters (never disable in production).
# NADA_OPENSEARCH_CA_CERTS=/path/to/ca.pem
NADA_OPENSEARCH_VERIFY_CERTS=true

# --- aws_sigv4 auth mode only ---
# NADA_AWS_REGION=              # required if not implicit from a boto3 session/profile
NADA_AWS_SERVICE=es              # "es" for an OpenSearch domain; "aoss" for OpenSearch Serverless
# NADA_AWS_PROFILE=             # optional named boto3 profile

# Composable index template (knn_vector mapping) applied before index
# create/bulk-ingest so auto-created indices inherit the right mapping.
NADA_OPENSEARCH_PUT_COMPOSABLE_INDEX_TEMPLATE=true
NADA_OPENSEARCH_INDEX_TEMPLATE_PRIORITY=500

# Cluster-level `action.auto_create_index` (requires cluster-manager
# permissions). Examples: "false" to disable all auto-create; an allowlist
# pattern like "+nada-metadata*,-*". Leave unset to not touch cluster settings.
# NADA_OPENSEARCH_CLUSTER_AUTO_CREATE_INDEX=


# ==============================================================================
# QDRANT (used when NADA_SEARCH_BACKEND=qdrant)
# ==============================================================================

NADA_QDRANT_URL=http://localhost:6333
# NADA_QDRANT_API_KEY=
NADA_QDRANT_PREFER_GRPC=false

# Overrides NADA_INDEX_NAME for the Qdrant collection name specifically.
# Leave unset to reuse NADA_INDEX_NAME.
# NADA_QDRANT_COLLECTION_NAME=

# Minimum similarity score for dense neighbors (query_points score_threshold).
# Cosine distance: higher = closer. Per-request JSON body can override this.
# NADA_QDRANT_VECTOR_SCORE_THRESHOLD=

# Cost cap: stop counting neighbors above the score threshold after this many
# points (only relevant when NADA_QDRANT_VECTOR_SCORE_THRESHOLD is set).
NADA_QDRANT_VECTOR_COUNT_SCAN_CAP=100000

# FastEmbed BM25 sparse vectors for the ranked keyword/hybrid lexical leg.
# Requires the `qdrant` extra: `uv sync --extra qdrant` (installs fastembed).
# Recreate the collection if you flip this on for an existing dense-only one.
NADA_QDRANT_SPARSE_LEXICAL=true
NADA_QDRANT_SPARSE_VECTOR_NAME=bm25
NADA_QDRANT_SPARSE_MODEL_ID=Qdrant/bm25

# When collapse_field is set on a hybrid Qdrant search, multiply the
# lexical/dense prefetch by this factor for post-RRF grouping.
NADA_QDRANT_HYBRID_COLLAPSE_PREFETCH_MULTIPLIER=4.0


# ==============================================================================
# EMBEDDINGS
# ==============================================================================

# "local": SentenceTransformers embed + k-NN queries (works with either
#          search backend). "opensearch_ml": OpenSearch ML Commons ingest
#          pipeline embeds server-side (OpenSearch only, no local model).
NADA_EMBEDDING_BACKEND=local

# --- local backend ---
NADA_EMBEDDING_MODEL_ID=microsoft/harrier-oss-v1-270m

# Asymmetric query encoding: named prompt used by
# SentenceTransformer.encode(..., prompt_name=...) when NADA_QUERY_PROMPT is
# unset. Set both empty/unset for symmetric (no prompt) encoding.
NADA_QUERY_PROMPT_NAME=web_search_query
# Literal prompt text; when set, overrides NADA_QUERY_PROMPT_NAME entirely.
# Example: "Instruct: Retrieve semantically similar text\nQuery: "
# NADA_QUERY_PROMPT=

# Extra kwargs passed to SentenceTransformer(...) as JSON, e.g. dtype/device
# hints beyond NADA_EMBEDDING_DEVICE below.
NADA_EMBEDDING_MODEL_KWARGS_JSON={"dtype": "auto"}
# Force a specific device ("cpu", "cuda", "mps"); unset = library auto-detect.
# NADA_EMBEDDING_DEVICE=
NADA_EMBEDDING_BATCH_SIZE=32

# --- opensearch_ml backend only ---
# Required: deployed ML Commons model id (_plugins/_ml/models).
# NADA_OPENSEARCH_ML_MODEL_ID=
# Required: vector length produced by that model; must match the knn_vector
# mapping. Common values: 384, 768, 1024.
# NADA_OPENSEARCH_ML_EMBEDDING_DIMENSION=
NADA_OPENSEARCH_ML_INGEST_PIPELINE_NAME=nada-text-embedding
# Skip PUT _ingest/pipeline if the pipeline already exists with the same
# definition (avoids a redundant call on every ingest run).
NADA_OPENSEARCH_ML_SKIP_INGEST_PIPELINE_SETUP=false


# ==============================================================================
# HYBRID SEARCH RANKING
# ==============================================================================

# Relative weight of the keyword vs. vector leg in hybrid-mode scoring.
NADA_HYBRID_KEYWORD_BOOST=0.3
NADA_HYBRID_VECTOR_BOOST=0.7


# ==============================================================================
# DYNAMIC FILTER FACETS
# ==============================================================================

# Path to the JSON registry of facetable dynamic filter keys (managed via
# GET/PUT/POST/DELETE /admin/facets). Defaults to
# config/dynamic_filter_facets.json relative to the repo root.
# NADA_DYNAMIC_FILTER_FACETS_PATH=


# ==============================================================================
# INGEST CONCURRENCY
# ==============================================================================

# Maximum number of ingest jobs allowed to run embedding compute
# simultaneously (guarded_ingest semaphore). Keep at 1 for GPU deployments
# (single-threaded model inference avoids OOM); raise to 2-4 for CPU-only
# deployments with plentiful cores.
NADA_MAX_CONCURRENT_INGEST_JOBS=1


# ==============================================================================
# ADMIN AUTH, RBAC, AUDIT TRAIL, RATE LIMITING
# ==============================================================================

# Legacy super-admin key (NOT parsed via pydantic-settings — read directly
# from the environment). If set, any caller presenting this exact value in
# the X-NADA-Admin-Key header is treated as role "admin" and can do anything.
# Keep it separate from any credential used to call OUT to external services
# (e.g. AI4DATA_METADATA_CATALOG_X_API_KEY below) — they are different trust
# boundaries; do not reuse the same secret value for both.
#
# If this is unset AND no per-caller API key has ever been issued (via
# POST /admin/keys), the server runs fully unauthenticated with a loud
# startup warning — convenient for local dev, never acceptable for anything
# reachable over a network. Set this before first deploy, or issue a
# dedicated key immediately after startup and never rely on the fail-open
# path in production.
# NADA_ADMIN_API_KEY=

# Where per-caller API keys are stored (id, name, role, SHA-256 hash of the
# key, revoked_at — never the raw key value). Defaults to
# config/api_keys.json relative to the repo root. Keep this file out of
# version control (already covered by .gitignore) and back it up like any
# other credential store.
# NADA_API_KEYS_PATH=

# Where the append-only JSONL audit trail is written (who did what, when,
# to what target, success/error). Defaults to config/audit.log relative to
# the repo root. Query it via GET /admin/audit (role: admin).
# NADA_AUDIT_LOG_PATH=

# Per-minute request cap per caller (admin key if presented, else client IP)
# on the public /search, /recommendations, /search/explain, and PDF preview
# endpoints. Set to 0 to disable rate limiting entirely.
NADA_RATE_LIMIT_SEARCH_PER_MINUTE=120


# ==============================================================================
# LOGGING
# ==============================================================================

# "text" (default, human-readable, request-ID-prefixed — good for local dev)
# or "json" (one JSON object per line — set this in any environment with a
# log aggregator that parses JSON: CloudWatch, Loki, Datadog, etc.).
NADA_LOG_FORMAT=text
# DEBUG | INFO | WARNING | ERROR | CRITICAL
NADA_LOG_LEVEL=INFO


# ==============================================================================
# METADATA-EXTRACT FILTER SYNC CLI (nada_ai.filters — separate from the
# AI4DATA_* catalog config below; these are consulted FIRST, falling back to
# the AI4DATA_METADATA_CATALOG_* equivalents when unset)
#
# nada-ai is designed to work against ANY NADA instance, not a single
# hardcoded deployment — set these to whichever instance's
# search-metadata-extract API you're syncing facet filters from (IHSN's
# Data Compass is one example instance, not a special case in the code).
# ==============================================================================

# Base URL for your NADA instance's search-metadata-extract API (no trailing
# slash). Falls back to AI4DATA_METADATA_CATALOG_URL + extract_path when
# unset. There is no hardcoded default — if neither is set, the filter sync
# CLI raises a clear "not configured" error rather than silently talking to
# someone else's instance.
# NADA_METADATA_EXTRACT_BASE_URL=

# Sent as the X-API-KEY header, if the deployment requires it. This is an
# OUTBOUND credential (nada-ai authenticating itself to the NADA catalog) —
# keep it distinct from NADA_ADMIN_API_KEY above, which is an INBOUND
# credential (callers authenticating to nada-ai). Sharing the same secret
# for both means a leak of either one grants both catalog read access and
# full admin control of your search index.
# NADA_METADATA_EXTRACT_API_KEY=

# Bearer token for "Authorization: Bearer ..." on extract API requests
# (admin endpoints that don't accept X-API-KEY alone).
# NADA_METADATA_EXTRACT_AUTH_BEARER=

# Raw Cookie header value for authenticated training/production NADA hosts
# that gate content behind a logged-in session.
# NADA_METADATA_EXTRACT_AUTH_COOKIE=


# ==============================================================================
# DISCOVERY CACHE + NADA CATALOG (ai4data package — NOT nada_ai.settings;
# these use the AI4DATA_ prefix and are validated by ai4data's own
# pydantic-settings classes)
# ==============================================================================

# Writable directory for discovery caches: metadata_ids, metadata_cache,
# document_cache (PDF previews), and bundled metadata helpers. Required in
# Docker and any CLI/ingest job. Alternative to setting this: call
# init_discovery_paths(Path(...)) from ai4data.discovery.config at startup.
AI4DATA_DISCOVERY_DATA_PATH=./data/nada-discovery

# --- NADA catalog API (ai4data.discovery.config.MetadataCatalogConfig) ---
# Base catalog URL for the NADA instance you're connecting to. Example below
# points at IHSN's public Data Compass instance — swap for your own NADA
# deployment's URL; nothing in this codebase assumes IHSN specifically.
# AI4DATA_METADATA_CATALOG_URL=https://training.ihsn.org/index.php
# Optional: thumbnail image URL template ({db_id} placeholder).
# AI4DATA_METADATA_CATALOG_THUMBNAIL_URL=

# When set, catalog list/fetch operations use the bulk
# search-metadata-extract API ({url}/{extract_path}/studies) instead of the
# classic /api/catalog/search + /api/catalog/json/{idno} endpoints. Details:
# docs/qdrant-pipeline-guide.md#configuration
# AI4DATA_METADATA_CATALOG_EXTRACT_PATH=api/admin/search-metadata-extract
# AI4DATA_METADATA_CATALOG_EXTRACT_INCLUDE_ADMIN_METADATA=true
# AI4DATA_METADATA_CATALOG_EXTRACT_INCLUDE_METADATA=true
# When include_resources is requested but the extract payload lacks
# resources, fall back to the classic /api/catalog/json/{idno} endpoint.
# AI4DATA_METADATA_CATALOG_EXTRACT_FALLBACK_CATALOG_JSON=false

# Outbound credentials for calling the catalog API — same trust-boundary
# note as NADA_METADATA_EXTRACT_API_KEY above: these authenticate
# nada-ai/ai4data TO the catalog, never reuse for authenticating callers of
# this app's own API.
# AI4DATA_METADATA_CATALOG_X_API_KEY=
# Comma-separated extra hostnames the x-api-key header may also be sent to
# (the configured catalog host is always allowed). Use when catalog-resolved
# download URLs live on a separate subdomain than the catalog API itself.
# AI4DATA_METADATA_CATALOG_X_API_KEY_HOSTS=training.ihsn.org,files.ihsn.org
# Cookie string for NADA instances that gate PDF downloads behind a
# logged-in session (e.g. "nada_session=...; ccsrf=...").
# AI4DATA_METADATA_CATALOG_COOKIES=
# Bearer token for admin extract endpoints that require it in addition to
# (or instead of) x-api-key.
# AI4DATA_METADATA_CATALOG_AUTH_BEARER=

# --- Metadata embedding-text templates (ai4data.discovery.config.EmbeddingTemplatesConfig) ---
# Directory containing per-metadata-type Jinja2 templates (indicator,
# document, ...) used to build the text that gets embedded. Rarely needs
# overriding — defaults to a bundled directory inside the ai4data package.
# AI4DATA_EMBEDDING_CONTENT_TEMPLATES_PATH=

# --- Discovery PDF/chunk embedding inference (ai4data.discovery.config.EmbeddingInferenceConfig) ---
# NOTE: this is a SEPARATE embedding model/pipeline from NADA_EMBEDDING_*
# above — it's used by ai4data's own document-chunking workflows, not by
# nada-ai's search index.
# AI4DATA_EMBEDDING_MODEL=avsolatorio/GIST-Embedding-v0
# AI4DATA_EMBEDDING_BATCH_SIZE=64
# AI4DATA_EMBEDDING_DEVICE=
# AI4DATA_EMBEDDING_SHOW_PROGRESS=true


# ==============================================================================
# MCP SERVER (standalone process: `python -m nada_ai.mcp_server`; uses the
# NADA_MCP_ prefix, a separate settings class from everything above)
# ==============================================================================

NADA_MCP_PORT=8025
# "http" (streamable-http transport) is the only officially supported value
# for the standalone server entrypoint.
NADA_MCP_TRANSPORT=http
# Log to a file in addition to stderr/stdout.
# NADA_MCP_LOG_FILE=
NADA_MCP_LOG_LEVEL=INFO
# Deployment environment label surfaced in logs (e.g. local, dev, staging, prod).
# NADA_MCP_ENV=

# Display name for the MCP server shown to MCP clients.
# NADA_MCP_SERVER_NAME=NADA MCP Server

# Prefix for every MCP tool name, e.g. "wdr" -> wdr_search_catalog. Lowercase
# letters, digits, underscores only.
NADA_MCP_TOOL_PREFIX=nada

# Human-readable catalog label inserted into the default tool descriptions
# shown to LLMs (e.g. "the {catalog_name} catalog").
NADA_MCP_CATALOG_NAME=NADA catalog

# Full overrides for specific tool descriptions, if the defaults built from
# NADA_MCP_CATALOG_NAME aren't specific enough for your deployment.
# NADA_MCP_SEARCH_CATALOG_DESCRIPTION=
# NADA_MCP_GET_METADATA_DESCRIPTION=

# When false, GET /ready returns 200 immediately with
# readiness_checks="disabled" instead of probing dependencies.
NADA_MCP_READINESS_ENABLED=true
# Per-dependency-check timeout (seconds) for GET /ready outbound probes.
NADA_MCP_HEALTH_CHECK_TIMEOUT=5.0
